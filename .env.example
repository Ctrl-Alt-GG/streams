COMPOSE_PROJECT_NAME=streams
GHCR_NAMESPACE=your-github-owner
APP_IMAGE_TAG=v0.1.0
DATA_DIR=./data

PUBLIC_BASE_URL=https://streams.example.com
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=streams.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://streams.example.com
DJANGO_SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

POSTGRES_USER=streams
POSTGRES_PASSWORD=change-postgres-password
POSTGRES_DB=streams
DATABASE_URL=postgresql://streams:change-postgres-password@postgres:5432/streams

REDIS_PASSWORD=change-redis-password
REDIS_URL=redis://:change-redis-password@redis:6379/0

RABBITMQ_DEFAULT_USER=streams
RABBITMQ_DEFAULT_PASS=change-rabbitmq-password
CELERY_BROKER_URL=amqp://streams:change-rabbitmq-password@rabbitmq:5672//
CELERY_LOG_LEVEL=INFO

MEDIAMTX_API_BASE_URL=https://mediamtx-api.example.com
MEDIAMTX_API_USERNAME=streams
MEDIAMTX_API_PASSWORD=change-mediamtx-password
MEDIAMTX_API_VERIFY_TLS=true
MEDIAMTX_HLS_PUBLIC_BASE_URL=https://media.example.com/hls
MEDIAMTX_RTMP_PUBLIC_BASE_URL=rtmps://media.example.com/live

MINIO_ROOT_USER=streams-root
MINIO_ROOT_PASSWORD=change-minio-root-password
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_STATIC_PUBLIC_URL=https://streams.example.com/static/
MINIO_STATIC_BUCKET=streams-static
MINIO_STATIC_ACCESS_KEY=streams-static
MINIO_STATIC_SECRET_KEY=change-minio-static-password
MINIO_REGION=us-east-1

WEB_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30