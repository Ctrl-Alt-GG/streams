# Compose passes this file to the web, setup, worker and beat containers. Postgres, Redis and
# RabbitMQ receive only their own variables, and the capture worker only REDIS_URL,
# CELERY_BROKER_URL, the MEDIAMTX_HLS_* addresses, the STREAM_THUMBNAIL_* settings and LOG_LEVEL.
COMPOSE_PROJECT_NAME=streams
GHCR_NAMESPACE=your-github-owner
APP_IMAGE_TAG=v0.1.0

PUBLIC_BASE_URL=https://streams.example.com
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=streams.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://streams.example.com
DJANGO_SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
# The host reverse proxy as the web container sees it: the gateway of the network in compose.yaml.
# Failed admin logins are counted per client address, which only its X-Forwarded-For can tell.
TRUSTED_PROXIES=172.31.241.1

POSTGRES_USER=streams
POSTGRES_PASSWORD=change-postgres-password
POSTGRES_DB=streams
DATABASE_URL=postgresql://streams:change-postgres-password@postgres:5432/streams

REDIS_PASSWORD=change-redis-password
REDIS_URL=redis://:change-redis-password@redis:6379/0

RABBITMQ_DEFAULT_USER=streams
RABBITMQ_DEFAULT_PASS=change-rabbitmq-password
CELERY_BROKER_URL=amqp://streams:change-rabbitmq-password@rabbitmq:5672//
CELERY_LOG_LEVEL=INFO

MEDIAMTX_API_BASE_URL=https://mediamtx-api.example.com
MEDIAMTX_API_USERNAME=streams
MEDIAMTX_API_PASSWORD=change-mediamtx-password
MEDIAMTX_API_VERIFY_TLS=true
MEDIAMTX_SNAPSHOT_RETENTION_SECONDS=3600
MEDIAMTX_HLS_PUBLIC_BASE_URL=https://media.example.com/hls
MEDIAMTX_RTMP_PUBLIC_BASE_URL=rtmps://media.example.com

TIME_ZONE=Europe/Budapest
# The catalog leaves out channels that haven't been live for this many days. 0 keeps them all.
STREAM_HIDE_OFFLINE_AFTER_DAYS=14

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30